#!/bin/sh
# Strip AI/tool attribution trailers. Used as prepare-commit-msg and commit-msg.

COMMIT_MSG_FILE="$1"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

tmp=$(mktemp) || exit 0

# grep -v exits 1 when every line is filtered; keep going either way.
grep -viE \
  -e '^[[:space:]]*Co-authored-by:' \
  -e '^[[:space:]]*Generated-by:' \
  -e '^[[:space:]]*Assisted-by:' \
  -e '^[[:space:]]*Signed-off-by:.*(Cursor|Claude|ChatGPT|Copilot|Codex|OpenAI|Anthropic|Gemini)' \
  "$COMMIT_MSG_FILE" > "$tmp" || true

mv "$tmp" "$COMMIT_MSG_FILE"
